#!/usr/bin/env python3
"""Queue an abook.link post in SABnzbd.

Usage (from the Mac): ssh servarr '~/servarr/scripts/abook "CODE" [PASSWORD] ["Author - Title"]'

Finds CODE on NZBKing and has SABnzbd fetch that NZB into the audiobooks
category with the archive password, named NAME (defaults to CODE).
Pass "" as PASSWORD to name an unpassworded post.
"""
import json
import re
import sys
import urllib.parse
import urllib.request

if len(sys.argv) not in (2, 3, 4):
    sys.exit(__doc__)
code = sys.argv[1]
password = sys.argv[2] if len(sys.argv) > 2 else ""
# Posts show codes like "abook.link - f5135574dfc3a2f5a7ee" or "abook.ws ~ BBAKRO-TPWRBK (1974)";
# NZBKing reads " - word" as an exclusion, so search the bare code only.
code = re.sub(r"^abook\.\w+\s*[-~]\s*|\s*\(\d{4}\)$", "", code.strip())
name = sys.argv[3] if len(sys.argv) == 4 else code

search = "https://nzbking.com/search/?" + urllib.parse.urlencode({"q": code})
req = urllib.request.Request(search, headers={"User-Agent": "Mozilla/5.0"})
html = urllib.request.urlopen(req).read().decode()
ids = list(dict.fromkeys(re.findall(r'href="/nzb:([0-9a-f]+)/"', html)))
if not ids:
    sys.exit(f"No NZBKing results for {code}")
if len(ids) > 1:
    sys.exit(f"{len(ids)} NZBKing results for {code}; pick one by hand: {search}")

ini = open("/docker/sabnzbd/sabnzbd.ini").read()
nzb_key = re.search(r"^nzb_key = (\S+)", ini, re.M).group(1)  # add-only key
params = {
    "mode": "addurl",
    "name": f"https://nzbking.com/nzb:{ids[0]}/",
    "nzbname": name,
    "cat": "audiobooks",
    "apikey": nzb_key,
    "output": "json",
}
if password:
    params["password"] = password
resp = json.load(urllib.request.urlopen("http://localhost:8080/api?" + urllib.parse.urlencode(params)))
if not resp.get("status"):
    sys.exit(f"SABnzbd refused: {resp}")
print(f"Queued: {name}")
